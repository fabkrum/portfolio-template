{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content.schema.json",
  "title": "Portfolio content file",
  "description": "All content of the portfolio site. The repo is public: never add a phone number or a postal address.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "headline", "bio"],
  "properties": {
    "$schema": { "type": "string" },
    "language": {
      "description": "Language of the site as a language code, for example en, it, de or en-GB. Defaults to en.",
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "default": "en"
    },
    "labels": {
      "description": "The page's own words in the site's language: section headings, link texts and the footer link. Leave a label out to keep it in English.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projects": { "$ref": "#/$defs/label" },
        "links": { "$ref": "#/$defs/label" },
        "cv": { "$ref": "#/$defs/label" },
        "experience": { "$ref": "#/$defs/label" },
        "education": { "$ref": "#/$defs/label" },
        "skills": { "$ref": "#/$defs/label" },
        "code": { "$ref": "#/$defs/label" },
        "live": { "$ref": "#/$defs/label" },
        "privacy": { "$ref": "#/$defs/label" },
        "videos": { "$ref": "#/$defs/label" },
        "podcasts": { "$ref": "#/$defs/label" },
        "posts": { "$ref": "#/$defs/label" },
        "resources": { "$ref": "#/$defs/label" },
        "ideas": { "$ref": "#/$defs/label" },
        "basedIn": { "$ref": "#/$defs/label" },
        "speaks": { "$ref": "#/$defs/label" },
        "native": { "$ref": "#/$defs/label" },
        "builtWith": { "$ref": "#/$defs/label" },
        "noTrackers": { "$ref": "#/$defs/label" }
      }
    },
    "name": { "type": "string", "minLength": 1 },
    "headline": {
      "description": "One line under your name: what you do.",
      "type": "string",
      "minLength": 1
    },
    "photo": {
      "description": "Optional photo of you, made with node tools/photo.mjs. src is the file under assets/, alt describes the photo in a few words for people who cannot see it.",
      "$ref": "#/$defs/image"
    },
    "pitch": {
      "description": "One sentence: what you offer, concrete. At most 160 characters.",
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "highlights": {
      "description": "Up to three things a visitor gets from you, each with an optional link that proves it.",
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "url": { "description": "A link that proves it, for example to a project or an article.", "$ref": "#/$defs/webUrl" }
        }
      }
    },
    "availability": {
      "description": "Whether you are available, in words with a date, and an optional action: a link a visitor clicks, with its text. Email is fine; phone numbers are not.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "dependentRequired": { "actionLabel": ["actionUrl"], "actionUrl": ["actionLabel"] },
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "actionLabel": { "description": "The text of the action's link, for example Write to me.", "type": "string", "minLength": 1 },
        "actionUrl": {
          "description": "Where the action's link goes: an address starting with https:// or an email link starting with mailto:.",
          "type": "string",
          "pattern": "^(https://|mailto:)"
        }
      }
    },
    "location": {
      "description": "Where you are based: the city only, never a street, a house number or a postcode.",
      "type": "object",
      "additionalProperties": false,
      "required": ["city"],
      "properties": {
        "city": { "$ref": "#/$defs/place" },
        "country": { "$ref": "#/$defs/place" },
        "timeZone": {
          "description": "Your time zone as its IANA name, for example Europe/Rome.",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*$"
        }
      }
    },
    "languages": {
      "description": "The languages you speak, each with its level: A1 to C2 as in the Common European Framework, or native.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "level"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2", "native"] }
        }
      }
    },
    "bio": {
      "description": "Short paragraphs about you.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "github"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "github": {
            "description": "Link to the project's GitHub repository.",
            "type": "string",
            "pattern": "^https://github\\.com/"
          },
          "url": { "$ref": "#/$defs/webUrl" }
        }
      }
    },
    "links": {
      "description": "Social and contact links. Email is fine; phone numbers are not.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": {
            "type": "string",
            "pattern": "^(https://|mailto:)"
          }
        }
      }
    },
    "cv": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experience": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "organization", "start"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "organization": { "type": "string", "minLength": 1 },
              "start": { "type": "string" },
              "end": { "type": "string" },
              "summary": { "type": "string" }
            }
          }
        },
        "education": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "organization"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "organization": { "type": "string", "minLength": 1 },
              "year": { "type": "string" }
            }
          }
        },
        "skills": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "videos": {
      "description": "Optional module: YouTube videos. Shown as links; the page never embeds the player, which would load from YouTube's servers.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": {
            "description": "Link to the video on YouTube.",
            "type": "string",
            "pattern": "^https://(www\\.|m\\.)?(youtube\\.com|youtu\\.be)/"
          },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "podcasts": {
      "description": "Optional module: podcast episodes, your own show or one you were a guest on.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "show": { "description": "Name of the podcast.", "type": "string", "minLength": 1 },
          "url": { "$ref": "#/$defs/webUrl" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "posts": {
      "description": "Optional module: blog posts, each a link to where it is published.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "$ref": "#/$defs/webUrl" },
          "date": { "description": "When it was published, for example 2026-03-14.", "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resources": {
      "description": "Optional module: links you recommend, such as docs, courses or tools.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "$ref": "#/$defs/webUrl" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ideas": {
      "description": "Optional module: project ideas you have not built yet.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "url": { "description": "Optional link, for example to an issue where you collect notes.", "$ref": "#/$defs/webUrl" }
        }
      }
    },
    "builtAt": {
      "description": "The event where you built this site with AI agents. It writes the line at the bottom of the page.",
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/webUrl" },
        "date": { "$ref": "#/$defs/date" }
      }
    }
  },
  "$defs": {
    "webUrl": { "type": "string", "pattern": "^https://" },
    "label": { "type": "string", "minLength": 1 },
    "date": {
      "description": "A date as year-month-day, for example 2026-10-10, or year-month, for example 2026-10.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?$"
    },
    "place": {
      "description": "A city or a country only: no street, no house number, no postcode.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^0-9]+$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt"],
      "properties": {
        "src": {
          "description": "A picture in the folder assets/: a .webp, .jpg, .png, .avif or .svg file, for example assets/photo.webp.",
          "type": "string",
          "pattern": "^assets/([A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.(webp|jpg|jpeg|png|avif|svg)$"
        },
        "alt": {
          "description": "What the picture shows, in a few words, for people who cannot see it.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
