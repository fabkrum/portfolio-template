{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content.schema.json",
  "title": "Portfolio content file",
  "description": "All content of the portfolio site. The repo is public: never add a phone number or a postal address.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "headline", "bio"],
  "properties": {
    "$schema": { "type": "string" },
    "language": {
      "description": "Language of the site as a language code, for example en, it, de or en-GB. Defaults to en.",
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "default": "en"
    },
    "labels": {
      "description": "The page's own words in the site's language: section headings, link texts and the footer link. Leave a label out to keep it in English.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projects": { "$ref": "#/$defs/label" },
        "links": { "$ref": "#/$defs/label" },
        "cv": { "$ref": "#/$defs/label" },
        "experience": { "$ref": "#/$defs/label" },
        "education": { "$ref": "#/$defs/label" },
        "skills": { "$ref": "#/$defs/label" },
        "code": { "$ref": "#/$defs/label" },
        "live": { "$ref": "#/$defs/label" },
        "privacy": { "$ref": "#/$defs/label" },
        "videos": { "$ref": "#/$defs/label" },
        "podcasts": { "$ref": "#/$defs/label" },
        "posts": { "$ref": "#/$defs/label" },
        "resources": { "$ref": "#/$defs/label" },
        "ideas": { "$ref": "#/$defs/label" }
      }
    },
    "name": { "type": "string", "minLength": 1 },
    "headline": {
      "description": "One line under your name: what you do.",
      "type": "string",
      "minLength": 1
    },
    "bio": {
      "description": "Short paragraphs about you.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "github"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "github": {
            "description": "Link to the project's GitHub repository.",
            "type": "string",
            "pattern": "^https://github\\.com/"
          },
          "url": { "$ref": "#/$defs/webUrl" }
        }
      }
    },
    "links": {
      "description": "Social and contact links. Email is fine; phone numbers are not.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": {
            "type": "string",
            "pattern": "^(https://|mailto:)"
          }
        }
      }
    },
    "cv": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experience": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "organization", "start"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "organization": { "type": "string", "minLength": 1 },
              "start": { "type": "string" },
              "end": { "type": "string" },
              "summary": { "type": "string" }
            }
          }
        },
        "education": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "organization"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "organization": { "type": "string", "minLength": 1 },
              "year": { "type": "string" }
            }
          }
        },
        "skills": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "videos": {
      "description": "Optional module: YouTube videos. Shown as links; the page never embeds the player, which would load from YouTube's servers.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": {
            "description": "Link to the video on YouTube.",
            "type": "string",
            "pattern": "^https://(www\\.|m\\.)?(youtube\\.com|youtu\\.be)/"
          },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "podcasts": {
      "description": "Optional module: podcast episodes, your own show or one you were a guest on.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "show": { "description": "Name of the podcast.", "type": "string", "minLength": 1 },
          "url": { "$ref": "#/$defs/webUrl" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "posts": {
      "description": "Optional module: blog posts, each a link to where it is published.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "$ref": "#/$defs/webUrl" },
          "date": { "description": "When it was published, for example 2026-03-14.", "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resources": {
      "description": "Optional module: links you recommend, such as docs, courses or tools.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "$ref": "#/$defs/webUrl" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ideas": {
      "description": "Optional module: project ideas you have not built yet.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "url": { "description": "Optional link, for example to an issue where you collect notes.", "$ref": "#/$defs/webUrl" }
        }
      }
    }
  },
  "$defs": {
    "webUrl": { "type": "string", "pattern": "^https://" },
    "label": { "type": "string", "minLength": 1 }
  }
}
